<body>
  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg">
      <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <h1 class="navbar-brand navbar-brand-autodark">
          <a href="/">
            <%= inline_svg "logo-mark.svg", width: "32", height: "32", alt: "Portal", class: "navbar-brand-image" %>
          </a>
        </h1>
        <div class="navbar-footer">
          <ul class="navbar-nav">
            <li class="nav-item dropup">
              <%= render 'common/profile_dropdown' %>
            </li>
          </ul>
        </div>
        <div class="collapse navbar-collapse" id="sidebar-menu">
          <%= render 'common/nav_items' %>
          <div class="my-md-0 flex-grow-1 flex-md-grow-0 order-first order-md-first">
            <%= render 'common/space_selector' %>
          </div>
        </div>
      </div>
    </aside>
    <div class="page-wrapper">
      <div class="container-xl">
        <div class="flex-row mb-4">
          <!-- Page title -->
          <div class="page-header d-print-none">
            <div class="row align-items-center">
              <%= render 'common/section_title' %>
            </div>
          </div>
        </div>
        <%= render 'common/flash' %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <%= yield %>
        </div>
      </div>
      <%= render 'common/footer' %>
    </div>
  </div>
</body>
